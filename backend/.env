PORT=3001
JWT_SECRET=your-secret-key-change-in-production
NODE_ENV=development

# SolusVM real console integration
# Example: https://panel.example.com/api/v1
SOLUSVM_API_BASE_URL=
SOLUSVM_API_TOKEN=
SOLUSVM_AUTH_HEADER=Authorization
SOLUSVM_AUTH_PREFIX=Bearer

# Endpoint templates
# Available placeholders: {instanceId} {hostname} {serviceId}
SOLUSVM_CONSOLE_PATH_TEMPLATE=
SOLUSVM_CONSOLE_METHOD=POST
SOLUSVM_CONSOLE_URL_FIELD=

# Resolve instance id when services.external_id is empty
SOLUSVM_LOOKUP_ENABLED=true
SOLUSVM_LOOKUP_PATH_TEMPLATE=
SOLUSVM_LOOKUP_METHOD=GET
SOLUSVM_LOOKUP_INSTANCE_ID_FIELD=
