PORT=10000
NODE_ENV=production
JWT_SECRET=replace-with-long-random-secret

# Frontend domain for CORS, example:
# CORS_ORIGIN=https://cservice.unaux.com
CORS_ORIGIN=

# SolusVM integration (optional for first deploy)
SOLUSVM_API_BASE_URL=
SOLUSVM_API_TOKEN=
SOLUSVM_AUTH_HEADER=Authorization
SOLUSVM_AUTH_PREFIX=Bearer

SOLUSVM_CONSOLE_PATH_TEMPLATE=
SOLUSVM_CONSOLE_METHOD=POST
SOLUSVM_CONSOLE_URL_FIELD=

SOLUSVM_LOOKUP_ENABLED=true
SOLUSVM_LOOKUP_PATH_TEMPLATE=
SOLUSVM_LOOKUP_METHOD=GET
SOLUSVM_LOOKUP_INSTANCE_ID_FIELD=
