<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Keep existing files and directories untouched.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all SPA requests to index.html.
  RewriteRule . /index.html [L]
</IfModule>
